{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/living-codex/v2/character.schema.json",
  "title": "Living Codex Character (v2)",
  "type": "object",
  "required": [
    "meta",
    "core",
    "abilities",
    "combat",
    "currency",
    "proficiencies",
    "trackers"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "id",
        "name",
        "ruleset_id",
        "created_utc",
        "modified_utc"
      ],
      "properties": {
        "schema": {
          "const": "living-codex-character"
        },
        "schema_version": {
          "const": "2.0.0"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ruleset_id": {
          "enum": [
            "dnd5e_2014",
            "dnd5e_2024"
          ]
        },
        "created_utc": {
          "type": "string",
          "format": "date-time"
        },
        "modified_utc": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": true
    },
    "core": {
      "type": "object",
      "required": [
        "rulesetId",
        "classes"
      ],
      "properties": {
        "rulesetId": {
          "type": "string",
          "minLength": 1
        },
        "speciesId": {
          "type": "string"
        },
        "classes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "level"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "isPrimary": {
                "type": "boolean"
              },
              "subclassId": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "abilities": {
      "type": "object",
      "required": [
        "str",
        "dex",
        "con",
        "int",
        "wis",
        "cha"
      ],
      "properties": {
        "str": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "dex": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "con": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "int": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "wis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "cha": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        }
      },
      "additionalProperties": false
    },
    "combat": {
      "type": "object",
      "required": [
        "ac",
        "initiative_bonus",
        "hp"
      ],
      "properties": {
        "ac": {
          "type": "integer",
          "minimum": 0
        },
        "initiative_bonus": {
          "type": "integer"
        },
        "hp": {
          "type": "object",
          "required": [
            "max",
            "current",
            "temp"
          ],
          "properties": {
            "max": {
              "type": "integer",
              "minimum": 0
            },
            "current": {
              "type": "integer",
              "minimum": 0
            },
            "temp": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "currency": {
      "type": "object",
      "required": [
        "cp",
        "sp",
        "ep",
        "gp",
        "pp"
      ],
      "properties": {
        "cp": {
          "type": "integer"
        },
        "sp": {
          "type": "integer"
        },
        "ep": {
          "type": "integer"
        },
        "gp": {
          "type": "integer"
        },
        "pp": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "proficiencies": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "saves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "armor": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "weapons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "expertise": {
      "type": "object",
      "properties": {
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "trackers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "current",
          "max",
          "reset"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "const": "counter"
          },
          "current": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 0
          },
          "reset": {
            "enum": [
              "none",
              "short_rest",
              "long_rest",
              "daily",
              "manual"
            ]
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "inventory": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "qty": { "type": "integer", "minimum": 0 },
          "notes": { "type": "string" },
          "item_type": { "enum": ["item", "ammunition"] },
          "ammunition_type": { "enum": ["", "arrow", "bolt", "bullet", "cannonball", "sling_bullet", "blowgun_needle", "custom"] },
          "unlimited_ammunition": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "attacks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ammunition_type": { "enum": ["", "arrow", "bolt", "bullet", "cannonball", "sling_bullet", "blowgun_needle", "custom"] },
          "ammunition_links": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "selected_ammunition_id": { "type": "string" },
          "unlimited_ammunition": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "enabled", "scope", "application_mode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "template_id": { "type": "string" },
          "name": { "type": "string" },
          "source": { "type": "string" },
          "class_id": { "type": "string" },
          "min_level": { "type": "integer", "minimum": 0 },
          "enabled": { "type": "boolean" },
          "dm_override": { "type": "boolean" },
          "scope": { "type": "string" },
          "application_mode": { "enum": ["auto", "suggested", "manual"] },
          "attack_roll_bonus": { "type": "integer" },
          "attack_roll_dice": { "type": "string" },
          "advantage_state": { "enum": ["advantage", "disadvantage", "none"] },
          "damage_bonus": { "type": "integer" },
          "damage_dice": { "type": "string" },
          "damage_type_add": { "type": "string" },
          "damage_type_replace": { "type": "string" },
          "crit_extra_dice": { "type": "string" },
          "requirements": { "type": "object" },
          "scaling": { "type": "array" },
          "usage": { "type": "object" },
          "resource": { "type": ["object", "null"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "companions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "lifecycle", "status", "hp", "abilities", "attacks", "effects"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string" },
          "template_id": { "type": "string" },
          "template_source": { "type": "string" },
          "template_kind": { "type": "string" },
          "template_level": { "type": ["integer", "null"], "minimum": 0 },
          "dm_override": { "type": "boolean" },
          "role": { "type": "string" },
          "source": { "type": "string" },
          "creature_type": { "type": "string" },
          "size": { "type": "string" },
          "alignment": { "type": "string" },
          "lifecycle": { "enum": ["persistent", "temporary"] },
          "status": { "enum": ["active", "inactive", "archived"] },
          "duration": { "type": "string" },
          "rounds_remaining": { "type": ["integer", "null"], "minimum": 0 },
          "replaces_id": { "type": "string" },
          "replacement": { "type": "object" },
          "ac": { "type": "integer", "minimum": 0 },
          "initiative_bonus": { "type": "integer" },
          "proficiency_bonus": { "type": "integer" },
          "challenge_rating": { "type": "string" },
          "hit_dice": { "type": "string" },
          "hp": { "type": "object" },
          "abilities": { "type": "object" },
          "movement": { "type": "object" },
          "saves": { "type": "object" },
          "skills": { "type": "array" },
          "senses": { "type": "string" },
          "languages": { "type": "string" },
          "defenses": { "type": "object" },
          "attacks": { "type": "array" },
          "actions": { "type": "array" },
          "bonus_actions": { "type": "array" },
          "reactions": { "type": "array" },
          "traits": { "type": "array" },
          "equipment": { "type": "array" },
          "effects": { "type": "array" },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "spells_known": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "spells_prepared": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "spell_slots": {
      "type": "object"
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "ui": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
